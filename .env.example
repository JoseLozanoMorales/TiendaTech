# CockroachDB distribuido (único motor de persistencia)
# Limite local por IP de transporte y por instancia del Gateway (no distribuido).
GATEWAY_RATE_LIMIT_REQUESTS=300
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
GATEWAY_RATE_LIMIT_MAX_CLIENTS=10000
# Puerto TCP/gRPC de pruebas expuesto solo en loopback.
RESERVATION_BIND_ADDRESS=127.0.0.1
# Solo desarrollo: conserva el valor predeterminado actual de Compose.
# Desactivar y configurar correo real antes de un despliegue publico.
OTP_MAIL_FALLBACK_ENABLED=true

CRDB_DATASOURCE_URL=jdbc:postgresql://tiendatech-crdb-1:26257,tiendatech-crdb-2:26257,tiendatech-crdb-3:26257/tiendatech?sslmode=disable&targetServerType=any&loadBalanceHosts=true
CRDB_DATASOURCE_USERNAME=root
CRDB_DATASOURCE_PASSWORD=
CRDB_RETRY_MAX_ATTEMPTS=3
CRDB_RETRY_DELAY_MS=100
CRDB_POOL_MAX_SIZE=10
CRDB_POOL_MIN_IDLE=2

# Autenticacion y correo; use valores locales, nunca secretos reales del equipo
AUTH_JWT_SECRET=reemplazar_por_un_secreto_largo_y_aleatorio
INTERNAL_SERVICE_TOKEN=reemplazar_por_un_token_interno_independiente_y_aleatorio
COOKIE_SECURE=false
TT_MAIL_USERNAME=
TT_MAIL_PASSWORD=
MAIL_CONNECTION_TIMEOUT_MS=5000
MAIL_READ_TIMEOUT_MS=5000
MAIL_WRITE_TIMEOUT_MS=5000

# AWS Bedrock: credenciales del microservicio armado-ia (analisis de cuello de botella).
# Cada integrante usa su propia clave IAM con permiso unicamente sobre Nova Lite.
# Si faltan estas variables el servicio sigue funcionando con el fallback deterministico.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Despliegue de imágenes publicadas en GitHub Container Registry (GHCR)
IMAGE_REPOSITORY=ghcr.io/reemplazar_usuario/tiendatech
IMAGE_TAG=reemplazar_hash_corto_del_commit_publicado
GATEWAY_BIND_ADDRESS=0.0.0.0
GATEWAY_PORT=8180
CRDB_CERTS_DIR=./crdb-certs

# Observabilidad. El perfil grafana-cloud permanece desactivado si no se usa.
APP_ENV=local
# Paso 7: estrategia única conmutable del banco experimental (2pc o saga).
COORD=2pc
FAULT_SEED=2026
FAULT_PROBABILITY=0.35
FAULT_DELAY_SECONDS=5
GRAFANA_CLOUD_PROM_URL=
GRAFANA_CLOUD_PROM_USERNAME=
GRAFANA_CLOUD_API_KEY=

# Paso 8: inyeccion de fallos controlada contra los microservicios reales (Jeremy, 5905639/98a6659).
# Desactivada por defecto; no altera el flujo productivo si no se activa.
EXPERIMENT_FAULT_INJECTION_ENABLED=false
EXPERIMENT_FAULT_DELAY_MS=5000
EXPERIMENT_OMISSION_DELAY_MS=9000

# pedidos-service: timeout del cliente REST hacia ventas/productos/usuarios (Jeremy, 5905639).
HTTP_CLIENT_READ_TIMEOUT_MS=7000

# Paso 10 item 5: Grafana local, solo desarrollo. Cambiar antes de exponer
# el puerto 3000 fuera de loopback (hoy solo bindea a 127.0.0.1).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
